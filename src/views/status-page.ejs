<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title><%= company.name %> status</title>
  <link rel="canonical" href="https://<%= host %>/">
</head>
<body>
  <h1><%= company.name %> status</h1>
  <p class="card"><strong><%= data.summary %></strong></p>

  <ul class="card">
    <% for (const component of data.components) { %>
    <li>
      <span><%= component.name %></span>
      <span class="badge grow <%= component.status %>"><%= component.status %></span>
    </li>
    <% } %>
  </ul>

  <form method="post" action="/subscribe" class="row">
    <input name="email" type="email" required placeholder="you@example.com" aria-label="Email">
    <button>Get updates</button>
  </form>
  <% if (locals.subscribed) { %>
    <p role="status">Subscribed to <%= company.name %> status updates.</p>
  <% } %>
  <% if (locals.error) { %>
    <p role="alert" class="error"><%= error %></p>
  <% } %>

  <p class="muted">Served on <%= host %></p>
</body>
</html>
